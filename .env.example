# Variables para docker-compose. Copia este archivo a ".env" y rellena los valores.
#   PowerShell:  Copy-Item .env.example .env
#   bash/zsh:    cp .env.example .env

# Supabase → Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=pega_aqui_la_service_role_key

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_por_un_secreto_largo_y_aleatorio

# Origen del frontend permitido por CORS (en Docker local es http://localhost)
FRONTEND_URL=http://localhost

# OAuth de Google (opcional). Vacío = botón de login con Google oculto.
GOOGLE_CLIENT_ID=

# Asistente de IA Gemini (opcional). Vacío = funciones de IA desactivadas (responden 503).
# Obtén una key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
